{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "scripts",
    "src",
    "supabase/functions/_shared",
    "supabase/functions/shopper-agent",
    "supabase/functions/auditor",
    "vite.config.ts"
  ],
  "exclude": [
    "supabase/functions/shopper-agent/index.ts",
    "supabase/functions/auditor/index.ts"
  ]
}
