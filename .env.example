# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable (anon) key only. NEVER put the service_role key or the Meta API key in a VITE_ variable:
# anything starting with VITE_ is shipped to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Edge-function secrets are NOT set here. Set them in Supabase > Edge Functions > Secrets:
#   MODEL_API_KEY   the Meta Model API key used by the shopper-agent function (never in the repo or Vercel)
#   DEMO_DATE       optional, YYYY-MM-DD, pins "today" for the demo store's delivery dates
